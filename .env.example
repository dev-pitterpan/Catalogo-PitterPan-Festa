# Servidor Node/Next.js local. Usado por npm run dev e npm start.
HOST=127.0.0.1
PORT=3000

# Opcional: domínio público dos links compartilhados.
# Vazio mantém public/data/config/site.json.
# NEXT_PUBLIC_ é visível no navegador. Nunca use para senhas/tokens.
NEXT_PUBLIC_CATALOG_URL=

# Desativa telemetria do framework neste ambiente.
NEXT_TELEMETRY_DISABLED=1
