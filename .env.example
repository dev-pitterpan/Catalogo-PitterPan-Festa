# Configuração local. Copie para .env e preencha somente os campos necessários.
# Nunca envie o .env ou tokens ao GitHub. NEXT_PUBLIC_ é visível no navegador.

# Aplicação (já utilizado pelo projeto)
HOST=127.0.0.1
PORT=3001
NEXT_PUBLIC_CATALOG_URL=https://catalogopitterpanfesta.vercel.app
NEXT_TELEMETRY_DISABLED=1

# Shopify — preparação para a futura importação de produtos e imagens.
# Estes campos ainda não ativam sincronização: o catálogo atual lê os JSONs.
# Domínio técnico confirmado no admin da loja: SEM https:// e SEM barra final.
# Exemplo de formato: sua-loja.myshopify.com (não usar admin.shopify.com/store/...).
SHOPIFY_STORE_DOMAIN=
SHOPIFY_API_VERSION=2026-07

# Admin GraphQL API — uso exclusivo no servidor.
# Token de acesso Admin válido, conforme o tipo de app/autenticação da sua loja.
# Não usar um token Storefront neste campo.
SHOPIFY_ADMIN_ACCESS_TOKEN=

# Alternativa para app do Dev Dashboard: credenciais para obter um token Admin.
# Só preencher se esse for o fluxo do seu app; não são o próprio access token.
# Client credentials exige app e loja da mesma organização e token renovado em ~24h.
# A obtenção/renovação automática ainda será implementada.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Referência de permissões para a futura importação (configurar no app Shopify).
# Este texto NÃO concede permissões nem altera o app instalado.
# read_products: produtos, variantes, coleções e mídia vinculada aos produtos.
# Acrescente read_inventory/read_locations apenas se consultarmos estoque por local.
SHOPIFY_READ_SCOPES=read_products

# Storefront API — opcional, para futura integração com a Cart API.
# O checkout atual usa permalinks e NÃO precisa de nenhum desses tokens.
# Token público e privado são tipos diferentes; preencher apenas o que for usado.
# Ambos ficam no servidor nesta arquitetura.
SHOPIFY_STOREFRONT_PUBLIC_ACCESS_TOKEN=
SHOPIFY_STOREFRONT_PRIVATE_ACCESS_TOKEN=

# Não há conexão com banco, importador ou upload implementados nesta etapa.
# Imagens importadas futuramente poderão ser baixadas para public/assets localmente.
# Na Vercel, arquivos gravados em execução não são armazenamento persistente.
