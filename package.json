{
  "name": "pitterpanfestas-catalogo-next",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/run-next.ts dev",
    "build": "next build",
    "start": "node scripts/run-next.ts start",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:server": "node tests/server.mjs",
    "format": "prettier --write src scripts tests *.json *.ts *.mjs",
    "format:check": "prettier --check src scripts tests *.json *.ts *.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.5",
    "lucide-react": "^1.60.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "@tailwindcss/postcss": "^4.3.3"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
